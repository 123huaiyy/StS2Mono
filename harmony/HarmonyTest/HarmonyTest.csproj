<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>StS2Mono.HarmonyTest</AssemblyName>
    <RootNamespace>StS2Mono.HarmonyTest</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The output of harmony/build.sh: the rewritten 0Harmony.dll and the adapter it calls. -->
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(MSBuildThisFileDirectory)../../out-harmony/</HarmonyDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(HarmonyDir)0Harmony.dll" />
    <Reference Include="StS2Mono.Harmony" HintPath="$(HarmonyDir)StS2Mono.Harmony.dll" />
  </ItemGroup>
</Project>
