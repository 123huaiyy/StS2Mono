Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>StS2Mono.HarmonyTest</AssemblyName>
    <RootNamespace>StS2Mono.HarmonyTest</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The 0Harmony.dll written by harmonypatch (harmony/build.sh). -->
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(MSBuildThisFileDirectory)../../out-harmony/0Harmony.dll</HarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(HarmonyPath)" />
    <ProjectReference Include="../StS2Mono.Harmony/StS2Mono.Harmony.csproj" />
  </ItemGroup>
</Project>
